<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <AssemblyName>NavisworksExport.Glb</AssemblyName>
    <RootNamespace>NavisworksExport.Glb</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpGLTF.Toolkit" Version="1.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NavisworksExport.Geometry\NavisworksExport.Geometry.csproj" />
  </ItemGroup>

  <!-- Prefer host-local API when Navisworks Manage 2023 is installed (target machine). -->
  <ItemGroup Condition="Exists('$(NavisworksInstallDir)Autodesk.Navisworks.Api.dll')">
    <Reference Include="Autodesk.Navisworks.Api">
      <HintPath>$(NavisworksInstallDir)Autodesk.Navisworks.Api.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
  </ItemGroup>

  <!-- Compile-time fallback when building on a machine without Navisworks installed. -->
  <ItemGroup Condition="!Exists('$(NavisworksInstallDir)Autodesk.Navisworks.Api.dll')">
    <PackageReference Include="NavisworksAPIdlls2023" Version="1.2.2">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Copy plugin + private deps (Geometry, SharpGLTF, …); skip Autodesk host assemblies. -->
  <Target Name="DeployToNavisworksPlugins" AfterTargets="Build">
    <ItemGroup>
      <_DeployDlls Include="$(TargetDir)*.dll" Exclude="$(TargetDir)Autodesk.*.dll" />
    </ItemGroup>
    <MakeDir Directories="$(NavisworksInstallDir)Plugins\$(AssemblyName)" ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="@(_DeployDlls)" DestinationFolder="$(NavisworksInstallDir)Plugins\$(AssemblyName)" OverwriteReadOnlyFiles="true" ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
