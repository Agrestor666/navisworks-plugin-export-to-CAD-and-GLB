<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <AssemblyName>NavisworksExport.AutoCad.2026</AssemblyName>
    <!-- C# namespaces cannot use a digit-leading segment; assembly/folder stay *.2026. -->
    <RootNamespace>NavisworksExport.AutoCad2026</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\NavisworksExport.AutoCad\Images\autocad16.png" Link="Images\autocad16.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\NavisworksExport.AutoCad\Images\autocad32.png" Link="Images\autocad32.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ACadSharp" Version="3.6.35" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NavisworksExport.Geometry.2026\NavisworksExport.Geometry.2026.csproj" />
  </ItemGroup>

  <!-- Manage 2026 host API only — install required; no NuGet fallback. -->
  <ItemGroup>
    <Reference Include="Autodesk.Navisworks.Api">
      <HintPath>$(NavisworksInstallDir2026)Autodesk.Navisworks.Api.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Autodesk.Navisworks.ComApi">
      <HintPath>$(NavisworksInstallDir2026)Autodesk.Navisworks.ComApi.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
  </ItemGroup>

  <!-- Copy plugin + private deps (Geometry.2026, ACadSharp, …); skip Autodesk host assemblies. -->
  <Target Name="DeployToNavisworksPlugins" AfterTargets="Build">
    <ItemGroup>
      <_DeployDlls Include="$(TargetDir)*.dll" Exclude="$(TargetDir)Autodesk.*.dll" />
      <!-- PDBs give line numbers in host-side stack traces. -->
      <_DeployDlls Include="$(TargetDir)*.pdb" />
      <_DeployIcons Include="$(TargetDir)Images\*.png" />
    </ItemGroup>
    <MakeDir Directories="$(NavisworksInstallDir2026)Plugins\$(AssemblyName)" ContinueOnError="WarnAndContinue" />
    <MakeDir Directories="$(NavisworksInstallDir2026)Plugins\$(AssemblyName)\Images" ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="@(_DeployDlls)" DestinationFolder="$(NavisworksInstallDir2026)Plugins\$(AssemblyName)" OverwriteReadOnlyFiles="true" ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="@(_DeployIcons)" DestinationFolder="$(NavisworksInstallDir2026)Plugins\$(AssemblyName)\Images" OverwriteReadOnlyFiles="true" ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
