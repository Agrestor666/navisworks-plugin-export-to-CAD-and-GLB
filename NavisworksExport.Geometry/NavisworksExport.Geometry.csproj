<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <AssemblyName>NavisworksExport.Geometry</AssemblyName>
    <RootNamespace>NavisworksExport.Geometry</RootNamespace>
  </PropertyGroup>

  <!-- Prefer host-local API when Navisworks Manage 2023 is installed (target machine). -->
  <ItemGroup Condition="Exists('$(NavisworksInstallDir)Autodesk.Navisworks.Api.dll')">
    <Reference Include="Autodesk.Navisworks.Api">
      <HintPath>$(NavisworksInstallDir)Autodesk.Navisworks.Api.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Autodesk.Navisworks.ComApi">
      <HintPath>$(NavisworksInstallDir)Autodesk.Navisworks.ComApi.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Autodesk.Navisworks.Interop.ComApi">
      <HintPath>$(NavisworksInstallDir)Autodesk.Navisworks.Interop.ComApi.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <!-- Compile-time fallback when building on a machine without Navisworks installed. -->
  <ItemGroup Condition="!Exists('$(NavisworksInstallDir)Autodesk.Navisworks.Api.dll')">
    <PackageReference Include="NavisworksAPIdlls2023" Version="1.2.2">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
