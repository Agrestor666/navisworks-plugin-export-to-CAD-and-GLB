<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <AssemblyName>NavisworksExport.Glb.2026</AssemblyName>
    <!-- C# namespaces cannot use a digit-leading segment; assembly/folder stay *.2026. -->
    <RootNamespace>NavisworksExport.Glb2026</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <!-- Manage 2026 host API only — install required; no NuGet fallback. -->
  <ItemGroup>
    <Reference Include="Autodesk.Navisworks.Api">
      <HintPath>$(NavisworksInstallDir2026)Autodesk.Navisworks.Api.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
  </ItemGroup>

  <Target Name="DeployToNavisworksPlugins" AfterTargets="Build">
    <MakeDir Directories="$(NavisworksInstallDir2026)Plugins\$(AssemblyName)" ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(NavisworksInstallDir2026)Plugins\$(AssemblyName)" OverwriteReadOnlyFiles="true" ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
